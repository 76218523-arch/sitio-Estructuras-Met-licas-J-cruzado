---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import fotoTaller from '../assets/taller.jpg.jpeg';
import fotoEstructuras from '../assets/estructuras.jpg.jpeg';
import fotoTrabajos from '../assets/trabajos.jpg.jpeg';
---
<Layout title="Nosotros | Estructuras Metálicas J. Cruzado" description="Conoce Estructuras Metálicas J. Cruzado, negocio ubicado en Rioja, San Martín." pagina="/nosotros">
<main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-16">
    <section class="mb-10 grid gap-8 md:grid-cols-2 md:items-center md:gap-10">
        <div><h1 class="mb-4 text-4xl font-bold text-acento sm:text-5xl">Nosotros</h1><p class="mb-4 text-lg">Somos Estructuras Metálicas J. Cruzado, un negocio ubicado en Rioja, San Martín, dedicado a la fabricación e instalación de estructuras metálicas.</p><p>Buscamos brindar soluciones de acuerdo con las necesidades de cada cliente, cuidando la planificación de cada trabajo y las características del proyecto.</p></div>
        <Image src={fotoTaller} alt="Espacio de trabajo del taller de estructuras metálicas" width={900} class="aspect-[4/3] w-full rounded-2xl object-cover shadow-lg" />
    </section>
    <section class="grid gap-6 md:grid-cols-2 md:items-start">
        <div class="rounded-2xl bg-metal/10 p-6"><h2 class="mb-3 text-2xl font-bold text-acento">Qué hacemos</h2><p>Realizamos trabajos relacionados con la fabricación de estructuras metálicas y soluciones de metal para diferentes proyectos.</p></div>
        <div class="rounded-2xl bg-metal/10 p-6"><h2 class="mb-3 text-2xl font-bold text-acento">Nuestro compromiso</h2><p>Escuchamos los requerimientos de cada cliente y brindamos información para que pueda solicitar una cotización acorde con su proyecto.</p></div>
    </section>
    <section class="mt-12"><h2 class="mb-3 text-3xl font-bold text-acento">Galería de trabajos</h2><p>Estas imágenes muestran nuestro entorno y trabajos relacionados con estructuras metálicas.</p>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3">
            <Image src={fotoTaller} alt="Vista del taller de trabajo" width={400} class="aspect-square w-full rounded-xl object-cover" />
            <Image src={fotoEstructuras} alt="Estructuras metálicas para construcción" width={400} class="aspect-square w-full rounded-xl object-cover" />
            <Image src={fotoTrabajos} alt="Trabajo de metal fabricado" width={400} class="aspect-square w-full rounded-xl object-cover" />
        </div>
    </section>
</main>
</Layout>
