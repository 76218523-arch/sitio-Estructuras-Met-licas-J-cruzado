
---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Nosotros | Estructuras Metálicas J. Cruzado</title>
    </head>

    <body class="bg-blanco text-industrial font-principal">
        <header class="bg-industrial text-blanco p-4">
            <a
                href="/"
                class="text-blanco font-bold text-xl no-underline"
            >
                Estructuras Metálicas J. Cruzado
            </a>

            <nav class="mt-3" aria-label="Principal">
                <ul class="list-none p-0">
                    <li class="inline-block mr-4">
                        <a href="/" class="text-blanco font-semibold no-underline">
                            Inicio
                        </a>
                    </li>

                    <li class="inline-block mr-4">
                        <a href="/servicios" class="text-blanco font-semibold no-underline">
                            Servicios
                        </a>
                    </li>

                    <li class="inline-block mr-4">
                        <a
                            href="/nosotros"
                            aria-current="page"
                            class="text-acento font-bold no-underline"
                        >
                            Nosotros
                        </a>
                    </li>

                    <li class="inline-block">
                        <a href="/contacto" class="text-blanco font-semibold no-underline">
                            Contacto
                        </a>
                    </li>
                </ul>
            </nav>
        </header>

        <main class="max-w-4xl mx-auto p-6">
            <section class="mb-8">
                <h1 class="text-acento text-3xl font-bold mb-3">
                    Nosotros
                </h1>

                <p class="text-lg">
                    Conoce nuestro negocio de estructuras metálicas.
                </p>
            </section>

            <section class="mb-8">
                <h2 class="text-acento text-2xl font-bold mb-3">
                    Qué hacemos
                </h2>

                <p>
                    Realizamos trabajos relacionados con la fabricación
                    de estructuras metálicas para diferentes proyectos.
                </p>
            </section>

            <section class="mb-8">
                <h2 class="text-acento text-2xl font-bold mb-3">
                    Nuestro compromiso
                </h2>

                <p>
                    Buscamos ofrecer soluciones adecuadas a las
                    necesidades de cada cliente.
                </p>
            </section>
        </main>

        <footer class="bg-industrial text-blanco text-center p-6">
            <p class="font-bold">
                Estructuras Metálicas J. Cruzado
            </p>

            <p>Rioja, San Martín, Perú</p>
        </footer>
    </body>
</html>
