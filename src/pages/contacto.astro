
---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>Contacto | Estructuras Metálicas J. Cruzado</title>

        <meta
            name="description"
            content="Contacta con Estructuras Metálicas J. Cruzado en Rioja, San Martín."
        />
    </head>

    <body class="bg-blanco text-industrial font-principal">
        <header class="bg-industrial text-blanco p-4">
            <a
                href="/"
                class="text-blanco font-bold text-xl no-underline"
            >
                Estructuras Metálicas J. Cruzado
            </a>

            <nav class="mt-3" aria-label="Principal">
                <ul class="list-none p-0">
                    <li class="inline-block mr-4">
                        <a href="/" class="text-blanco font-semibold no-underline">
                            Inicio
                        </a>
                    </li>

                    <li class="inline-block mr-4">
                        <a href="/servicios" class="text-blanco font-semibold no-underline">
                            Servicios
                        </a>
                    </li>

                    <li class="inline-block mr-4">
                        <a href="/nosotros" class="text-blanco font-semibold no-underline">
                            Nosotros
                        </a>
                    </li>

                    <li class="inline-block">
                        <a
                            href="/contacto"
                            aria-current="page"
                            class="text-acento font-bold no-underline"
                        >
                            Contacto
                        </a>
                    </li>
                </ul>
            </nav>
        </header>

        <main class="max-w-4xl mx-auto p-6">
            <section class="mb-8">
                <h1 class="text-acento text-3xl font-bold mb-3">
                    Contáctanos
                </h1>

                <p class="text-lg">
                    Solicita información sobre nuestros servicios
                    de estructuras metálicas.
                </p>
            </section>

            <section class="mb-8">
                <h2 class="text-acento text-2xl font-bold mb-3">
                    Teléfono y WhatsApp
                </h2>

                <p>
                    Comunícate con nosotros para consultar sobre tu proyecto.
                </p>

                <p class="mt-3">
                    <a
                        href="tel:+51904888946"
                        class="inline-block bg-acento text-industrial font-bold p-3 rounded-lg no-underline"
                    >
                        Llamar al negocio
                    </a>
                </p>

                <p class="mt-3">
                    <a
                        href="https://wa.me/51904888946"
                        class="inline-block bg-industrial text-blanco font-bold p-3 rounded-lg no-underline"
                    >
                        Contactar por WhatsApp
                    </a>
                </p>
            </section>

            <section class="mb-8">
                <h2 class="text-acento text-2xl font-bold mb-3">
                    Horario de atención
                </h2>

                <p>
                    Consulta nuestro horario de atención antes de visitarnos.
                </p>
            </section>

            <section class="mb-8">
                <h2 class="text-acento text-2xl font-bold mb-3">
                    Dónde estamos
                </h2>

                <p>Rioja, San Martín, Perú.</p>
            </section>

            <!-- MAPA DE GOOGLE MAPS -->
            <section class="mb-8">
                <h2 class="text-acento text-2xl font-bold mb-3">
                    Nuestra ubicación
                </h2>

                <p class="mb-4">
                    Visítanos en nuestra ubicación en Rioja,
                    departamento de San Martín.
                </p>

            
                    <iframe
                  src="https://www.google.com/maps?q=-6.013443,-77.162528&output=embed"
                  title="Mapa de ubicación de Estructuras Metálicas J. Cruzado"
                  width="100%"
                   height="400"
                   class="border-0 rounded-lg"
                  loading="lazy"
                   allowfullscreen
                 referrerpolicy="no-referrer-when-downgrade">

                </iframe>
            </section>
        </main>

        <footer class="bg-industrial text-blanco text-center p-6">
            <p class="font-bold">
                Estructuras Metálicas J. Cruzado
            </p>

            <p>Rioja, San Martín, Perú</p>
        </footer>
    </body>
</html>
