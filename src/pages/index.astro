
---
import { Image } from 'astro:assets';

import fotoTaller from '../assets/taller.jpg.jpeg';
import fotoEstructuras from '../assets/estructuras.jpg.jpeg';
import fotoTrabajos from '../assets/trabajos.jpg.jpeg';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>Inicio | Estructuras Metálicas J. Cruzado</title>

        <meta
            name="description"
            content="Conoce los servicios de Estructuras Metálicas J. Cruzado en Rioja, San Martín."
        />
    </head>

    <body>
        <header class="bg-industrial text-blanco p-4">
            <a href="/" class="text-blanco font-bold text-xl">
                Estructuras Metálicas J. Cruzado
            </a>

            <nav class="mt-3" aria-label="Menú principal">
                <ul>
                    <li><a href="/" aria-current="page">Inicio</a></li>
                    <li><a href="/servicios">Servicios</a></li>
                    <li><a href="/nosotros">Nosotros</a></li>
                    <li><a href="/contacto">Contacto</a></li>
                </ul>
            </nav>
        </header>

        <main>
            <section>
                <h1>Estructuras Metálicas J. Cruzado</h1>

                <p>
                    Bienvenidos a Estructuras Metálicas J. Cruzado,
                    un negocio dedicado a los trabajos de fabricación
                    de estructuras metálicas.
                </p>

                <p class="font-bold">
                    Ofrecemos soluciones para proyectos que requieren
                    trabajos con estructuras de metal.
                </p>

                <p>
                    Nuestro objetivo es conocer las necesidades de
                    cada cliente y ofrecer alternativas adecuadas
                    para su proyecto.
                </p>
            </section>

            <section>
                <h2>Nuestros servicios</h2>

                <p>
                    Conoce nuestros servicios de fabricación de
                    estructuras metálicas y trabajos de metal.
                </p>

                <p>
                    <a href="/servicios">Ver nuestros servicios</a>
                </p>

                <p>
                    ¿Necesitas información para tu proyecto?
                    Visita nuestra página de contacto.
                </p>

                <p>
                    <a href="/contacto">Contáctanos</a>
                </p>
            </section>

            <section class="galeria">
                <h2>Nuestros trabajos realizados</h2>

                <p>
                    Conoce algunas imágenes relacionadas con
                    nuestro trabajo en estructuras metálicas.
                </p>

                <div class="contenedor-fotos">
                    <figure>
                        <Image
                            src={fotoTaller}
                            alt="Taller de trabajo de estructuras metálicas"
                            width={640}
                        />
                        <figcaption>Nuestro taller</figcaption>
                    </figure>

                    <figure>
                        <Image
                            src={fotoEstructuras}
                            alt="Estructuras metálicas para construcciones"
                            width={640}
                        />
                        <figcaption>Estructuras metálicas</figcaption>
                    </figure>

                    <figure>
                        <Image
                            src={fotoTrabajos}
                            alt="Trabajos de fabricación e instalación metálica"
                            width={640}
                        />
                        <figcaption>Trabajos realizados</figcaption>
                    </figure>
                </div>
            </section>
        </main>

        <footer>
            <p>Estructuras Metálicas J. Cruzado</p>
            <address>Rioja, San Martín, Perú.</address>
        </footer>
    </body>
</html>

<style>
    /* ESTILOS GENERALES */
    body {
        margin: 0;
        background-color: #FFFFFF;
        color: #1F2937;
        font-family: Arial, sans-serif;
        font-size: 1.0625rem;
        line-height: 1.6;
    }

    /* TÍTULOS */
    h1,
    h2,
    h3 {
        font-family: Georgia, serif;
        color: #F59E0B;
    }

    /* CABECERA */
    header {
        background-color: #1F2937;
        padding: 1rem 1.5rem;
    }

    header a {
        color: #FFFFFF;
        font-weight: 600;
        text-decoration: none;
    }

    nav ul {
        list-style: none;
        padding: 0;
    }

    nav li {
        display: inline-block;
        margin-right: 15px;
    }

    /* ENLACES */
    a {
        color: #F59E0B;
    }

    header a {
        color: #FFFFFF;
    }

    /* CONTENIDO */
    main {
        max-width: 48rem;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    /* GALERÍA */
    .galeria {
        padding: 30px 20px;
        text-align: center;
    }

    .contenedor-fotos {
        display: block;
        margin-top: 25px;
    }

    .contenedor-fotos figure {
        margin: 0 0 20px;
        padding: 12px;
        background: #F4F4F4;
        border-radius: 10px;
    }

    .contenedor-fotos img {
        display: block;
        width: 100%;
        height: 240px;
        object-fit: cover;
        border-radius: 8px;
    }

    .contenedor-fotos figcaption {
        margin-top: 10px;
        font-weight: bold;
    }

    /* BOTÓN */
    .boton {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border: 2px solid #F59E0B;
        border-radius: 999px;
        margin-top: 1rem;
        background-color: #F59E0B;
        color: #1F2937;
        font-weight: 600;
        text-decoration: none;
    }

    /* PIE DE PÁGINA */
    footer {
        padding: 1.5rem;
        background-color: #1F2937;
        color: #FFFFFF;
        text-align: center;
    }

    img {
        max-width: 100%;
        height: auto;
    }
</style>
